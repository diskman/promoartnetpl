{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Start Jekyll (Docker Compose)",
            "type": "shell",
            "command": "docker-compose up",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "new"
            }
        },
        {
            "label": "Stop Jekyll (Docker Compose)",
            "type": "shell",
            "command": "docker-compose down",
            "presentation": {
                "reveal": "always",
                "panel": "new"
            }
        }
    ]
}
